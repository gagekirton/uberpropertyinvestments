---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Services', href: '#services' },
    { linkText: 'Properties', href: '#properties' },
    { linkText: 'Contact', href: '#contact' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 sm:pt-8 sm:pb-12">
    <a href="/" class="flex items-center gap-2 no-underline">
        <div class="w-10 h-10 rounded-lg bg-amber-500 flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
        </div>
        <span class="font-bold text-lg">Uber Property</span>
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-2 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-3 py-2 text-sm font-medium text-gray-300 hover:text-white transition-colors no-underline">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>

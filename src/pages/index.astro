<style>
  :root{
    --steel:#232B2E;
    --steel-2:#2E383C;
    --brick:#A63D2F;
    --brick-2:#8C3226;
    --amber:#E8A33D;
    --lake:#5C7A8A;
    --paper:#F3EEE3;
    --paper-2:#EAE2D2;
    --ink:#1B211F;
    --smoke:#6B7573;
    --line:rgba(255,255,255,0.12);
    --line-dark:rgba(27,33,31,0.12);
    --radius:4px;
    --max:1180px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block; max-width:100%;}
  a{color:inherit;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 28px;}
  h1,h2,h3{
    font-family:'Archivo Expanded',sans-serif;
    font-weight:900;
    letter-spacing:-0.01em;
    line-height:1.05;
  }
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-weight:600;
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
  }
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    font-family:'Inter',sans-serif; font-weight:700; font-size:15.5px;
    padding:16px 26px; border-radius:var(--radius);
    border:2px solid transparent; cursor:pointer;
    text-decoration:none; transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
    white-space:nowrap;
  }
  .btn-amber{background:var(--amber); color:var(--ink); box-shadow:0 3px 0 #b47a1f;}
  .btn-amber:hover{transform:translateY(-2px); box-shadow:0 5px 0 #b47a1f;}
  .btn-amber:active{transform:translateY(1px); box-shadow:0 2px 0 #b47a1f;}
  .btn-outline{background:transparent; border-color:var(--paper); color:var(--paper);}
  .btn-outline:hover{background:var(--paper); color:var(--steel);}
  .btn-brick{background:var(--brick); color:var(--paper); box-shadow:0 3px 0 var(--brick-2);}
  .btn-brick:hover{transform:translateY(-2px); box-shadow:0 5px 0 var(--brick-2);}
  .btn-brick:active{transform:translateY(1px); box-shadow:0 2px 0 var(--brick-2);}
  .btn-wide{width:100%;}

  /* ===== HEADER ===== */
  header{
    position:sticky; top:0; z-index:50;
    background:var(--steel); border-bottom:1px solid var(--line);
  }
  .nav{display:flex; align-items:center; justify-content:space-between; padding:16px 0;}
  .brand{display:flex; align-items:center; gap:12px; text-decoration:none;}
  .brand-mark{
    width:42px; height:42px; border-radius:50%;
    background:var(--amber); color:var(--steel);
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:13px;
    border:2px solid var(--paper); flex-shrink:0;
  }
  .brand-text{color:var(--paper); font-family:'Archivo Expanded',sans-serif; font-weight:900; font-size:16.5px; line-height:1.1;}
  .brand-text span{display:block; font-family:'IBM Plex Mono',monospace; font-weight:500; font-size:10.5px; letter-spacing:.1em; color:var(--amber); margin-top:3px;}
  .nav-right{display:flex; align-items:center; gap:18px;}
  .nav-phone{color:var(--paper); text-decoration:none; font-weight:700; font-size:15.5px; display:flex; align-items:center; gap:8px;}
  .nav-phone svg{width:18px; height:18px; stroke:var(--amber);}
  .nav-cta{display:none;}
  @media(min-width:720px){ .nav-cta{display:inline-flex;} }

  /* ===== HERO ===== */
  .hero{background:var(--steel); color:var(--paper); position:relative; overflow:hidden;}
  .hero-grid{
    display:grid; grid-template-columns:1fr; gap:50px;
    padding:56px 0 64px;
    align-items:center;
  }
  @media(min-width:960px){ .hero-grid{grid-template-columns:1.05fr 0.95fr; padding:76px 0 88px;} }
  .hero-eyebrow{color:var(--amber); margin-bottom:16px;}
  .hero h1{font-size:clamp(32px,5.4vw,50px); color:var(--paper); margin-bottom:18px;}
  .hero h1 em{font-style:normal; color:var(--amber);}
  .hero p.sub{font-size:17.5px; color:#C9CFCE; max-width:520px; margin-bottom:30px;}
  .hero-card{
    background:var(--paper); color:var(--ink); border-radius:var(--radius);
    padding:26px; box-shadow:0 20px 40px rgba(0,0,0,0.28);
  }
  .hero-card h3{font-size:19px; margin-bottom:4px;}
  .hero-card .small{font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--smoke); letter-spacing:.05em; margin-bottom:18px; display:block;}
  .field-row{display:flex; flex-direction:column; gap:12px; margin-bottom:14px;}
  input[type=text],input[type=tel],input[type=email]{
    width:100%; padding:14px 16px; border:1.5px solid var(--line-dark);
    border-radius:var(--radius); font-family:'Inter',sans-serif; font-size:15px;
    background:#fff; color:var(--ink);
  }
  input:focus{outline:3px solid var(--lake); outline-offset:1px;}
  .or-divider{display:flex; align-items:center; gap:12px; margin:18px 0; color:var(--smoke); font-size:13px;}
  .or-divider::before,.or-divider::after{content:""; flex:1; height:1px; background:var(--line-dark);}
  .call-row{display:flex; align-items:center; justify-content:center; gap:10px; text-decoration:none; padding:14px; border:2px solid var(--steel); border-radius:var(--radius); font-weight:700; color:var(--steel);}
  .call-row svg{width:18px; height:18px; stroke:var(--brick);}
  .call-row:hover{background:var(--paper-2);}
  .fine-print{font-size:12px; color:var(--smoke); margin-top:14px; text-align:center;}

  /* hero illustration */
  .hero-art{display:flex; align-items:flex-end; justify-content:center; padding:0 10px;}

  /* ===== TRUST BAR ===== */
  .trust{background:var(--paper-2); border-bottom:1px solid var(--line-dark); border-top:1px solid var(--line-dark);}
  .trust-grid{
    display:grid; grid-template-columns:repeat(2,1fr); gap:24px;
    padding:34px 0; text-align:center;
  }
  @media(min-width:720px){ .trust-grid{grid-template-columns:repeat(4,1fr);} }
  .trust-item .num{font-family:'Archivo Expanded',sans-serif; font-weight:900; font-size:clamp(24px,3.4vw,34px); color:var(--brick);}
  .trust-item .lbl{font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--smoke); margin-top:4px;}

  /* ===== SECTION GENERIC ===== */
  section{padding:74px 0;}
  .section-head{max-width:640px; margin-bottom:44px;}
  .section-head .eyebrow{color:var(--brick); margin-bottom:12px;}
  .section-head h2{font-size:clamp(26px,3.6vw,38px); color:var(--ink);}
  .section-head p{color:var(--smoke); font-size:16px; margin-top:14px;}
  .section-alt{background:var(--paper-2);}

  /* ===== HOW IT WORKS ===== */
  .steps{display:grid; grid-template-columns:1fr; gap:28px;}
  @media(min-width:820px){ .steps{grid-template-columns:repeat(3,1fr);} }
  .step{position:relative; padding-top:6px;}
  .step-num{
    font-family:'Archivo Expanded',sans-serif; font-weight:900; font-size:46px;
    color:transparent; -webkit-text-stroke:1.5px var(--brick); margin-bottom:12px; display:block;
  }
  .step h3{font-size:19px; margin-bottom:10px; color:var(--ink);}
  .step p{color:var(--smoke); font-size:15px;}
  .step-line{display:none;}
  @media(min-width:820px){
    .step:not(:last-child)::after{
      content:""; position:absolute; top:26px; left:calc(100% + 4px); width:calc(28px - 8px);
      border-top:2px dashed var(--line-dark);
    }
  }

  /* ===== BENEFIT GRID ===== */
  .benefits{display:grid; grid-template-columns:1fr; gap:18px;}
  @media(min-width:640px){ .benefits{grid-template-columns:repeat(2,1fr);} }
  @media(min-width:960px){ .benefits{grid-template-columns:repeat(3,1fr);} }
  .benefit{
    background:#fff; border:1px solid var(--line-dark); border-radius:var(--radius);
    padding:24px; display:flex; gap:14px; align-items:flex-start;
  }
  .benefit svg{width:26px; height:26px; stroke:var(--brick); flex-shrink:0; margin-top:2px;}
  .benefit h4{font-size:16.5px; margin-bottom:6px; font-family:'Inter',sans-serif; font-weight:700;}
  .benefit p{font-size:14px; color:var(--smoke);}

  /* ===== SITUATIONS ===== */
  .sit-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px;}
  @media(min-width:720px){ .sit-grid{grid-template-columns:repeat(4,1fr);} }
  .sit-chip{
    background:var(--steel); color:var(--paper); border-radius:var(--radius);
    padding:20px 16px; font-weight:700; font-size:14.5px; text-align:center;
    border-left:4px solid var(--amber);
  }

  /* ===== ABOUT ===== */
  .about{display:grid; grid-template-columns:1fr; gap:40px; align-items:center;}
  @media(min-width:900px){ .about{grid-template-columns:0.9fr 1.1fr;} }
  .about-badge{
    width:210px; height:210px; border-radius:50%; border:3px dashed var(--brick);
    display:flex; align-items:center; justify-content:center; text-align:center;
    margin:0 auto; padding:20px;
  }
  .about-badge .inner{
    font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:.08em; line-height:1.6;
    color:var(--brick); font-weight:600;
  }
  .about-text h2{font-size:clamp(24px,3.2vw,32px); margin-bottom:16px;}
  .about-text p{color:var(--smoke); font-size:15.5px; margin-bottom:14px;}
  .about-text p:last-child{margin-bottom:0;}

  /* ===== TESTIMONIALS ===== */
  .test-grid{display:grid; grid-template-columns:1fr; gap:22px;}
  @media(min-width:820px){ .test-grid{grid-template-columns:repeat(3,1fr);} }
  .test-card{
    background:#fff; border:1px solid var(--line-dark); border-radius:var(--radius);
    padding:26px; position:relative;
  }
  .test-mark{font-family:'Archivo Expanded',sans-serif; font-size:44px; color:var(--amber); line-height:1; margin-bottom:6px; display:block;}
  .test-card p.quote{font-size:15px; color:var(--ink); margin-bottom:18px;}
  .test-who{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--smoke); letter-spacing:.03em;}
  .test-who strong{color:var(--ink); font-family:'Inter',sans-serif;}

  /* ===== SERVICE AREA ===== */
  .area-tags{display:flex; flex-wrap:wrap; gap:10px; margin-top:8px;}
  .area-tag{
    font-family:'IBM Plex Mono',monospace; font-size:12.5px; letter-spacing:.03em;
    background:#fff; border:1px solid var(--line-dark); border-radius:20px; padding:9px 16px;
  }

  /* ===== FAQ ===== */
  .faq-list{max-width:760px;}
  .faq-item{border-bottom:1px solid var(--line-dark);}
  .faq-q{
    width:100%; text-align:left; background:none; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:20px 4px; font-family:'Inter',sans-serif; font-weight:700; font-size:16px; color:var(--ink);
  }
  .faq-q .plus{font-family:'Archivo Expanded',sans-serif; font-size:22px; color:var(--brick); transition:transform .2s ease; flex-shrink:0;}
  .faq-item.open .plus{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height .25s ease;}
  .faq-a p{padding:0 4px 20px; color:var(--smoke); font-size:15px; max-width:620px;}

  /* ===== FINAL CTA ===== */
  .final-cta{background:var(--brick); color:var(--paper); text-align:center;}
  .final-cta h2{font-size:clamp(26px,3.8vw,38px); color:var(--paper); margin-bottom:14px;}
  .final-cta p{color:#F0D9D3; max-width:520px; margin:0 auto 32px;}
  .final-form{
    max-width:520px; margin:0 auto; background:var(--paper); border-radius:var(--radius);
    padding:26px; color:var(--ink);
  }

  /* ===== FOOTER ===== */
  footer{background:var(--steel); color:#AEB6B4; padding:50px 0 26px; font-size:13.5px;}
  .foot-grid{display:grid; grid-template-columns:1fr; gap:32px; margin-bottom:36px;}
  @media(min-width:820px){ .foot-grid{grid-template-columns:1.3fr 1fr 1fr;} }
  .foot-brand{color:var(--paper); font-family:'Archivo Expanded',sans-serif; font-weight:900; font-size:17px; margin-bottom:10px;}
  footer h5{font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--amber); margin-bottom:14px;}
  footer ul{list-style:none;}
  footer li{margin-bottom:8px;}
  footer a{text-decoration:none;}
  footer a:hover{color:var(--paper);}
  .foot-bottom{border-top:1px solid var(--line); padding-top:22px; display:flex; flex-wrap:wrap; gap:10px 24px; justify-content:space-between; font-size:12px; color:#7C8583;}

  .visually-hidden{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);}
  :focus-visible{outline:3px solid var(--lake); outline-offset:2px;}
  @media (prefers-reduced-motion: reduce){ *{transition:none !important; scroll-behavior:auto !important;} }
</style>

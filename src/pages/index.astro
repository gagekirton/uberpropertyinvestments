---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Uber Property Investments | Premier Real Estate Solutions">
    <!-- Hero Section -->
    <section class="relative -mx-6 sm:-mx-12 -mt-6 overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img
                src="/images/hero-real-estate.png"
                alt="Luxury real estate property"
                class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-gray-900/90 via-gray-900/70 to-gray-900/40"></div>
        </div>
        <div class="relative z-10 px-6 sm:px-12 py-24 md:py-32 lg:py-40 max-w-3xl">
            <span class="inline-block px-4 py-1.5 mb-6 text-sm font-medium bg-amber-500/90 text-gray-900 rounded-full">
                Premier Real Estate Investments
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
                Your Journey to <span class="text-amber-400">Exceptional</span> Property Begins Here
            </h1>
            <p class="text-xl text-gray-200 mb-8 max-w-xl">
                Discover premium investment opportunities and luxury properties tailored to your aspirations. Expert guidance, exceptional results.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="#properties" class="btn btn-primary">
                    View Properties
                </a>
                <a href="#contact" class="btn btn-outline">
                    Schedule Consultation
                </a>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-16 border-b border-gray-700/50">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div>
                <div class="text-3xl sm:text-4xl font-bold text-amber-400 mb-2">500+</div>
                <div class="text-gray-400 text-sm sm:text-base">Properties Sold</div>
            </div>
            <div>
                <div class="text-3xl sm:text-4xl font-bold text-amber-400 mb-2">$2.5B</div>
                <div class="text-gray-400 text-sm sm:text-base">Transaction Volume</div>
            </div>
            <div>
                <div class="text-3xl sm:text-4xl font-bold text-amber-400 mb-2">15+</div>
                <div class="text-gray-400 text-sm sm:text-base">Years Experience</div>
            </div>
            <div>
                <div class="text-3xl sm:text-4xl font-bold text-amber-400 mb-2">98%</div>
                <div class="text-gray-400 text-sm sm:text-base">Client Satisfaction</div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="py-16" id="services">
        <div class="text-center mb-12">
            <span class="text-amber-400 font-medium tracking-wider uppercase text-sm">What We Offer</span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Our Services</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-gray-800/50 rounded-xl p-8 border border-gray-700/50 hover:border-amber-400/50 transition-colors">
                <div class="w-14 h-14 rounded-lg bg-amber-400/10 flex items-center justify-center mb-6">
                    <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Property Acquisition</h3>
                <p class="text-gray-400 leading-relaxed">
                    Strategic property sourcing with rigorous due diligence to secure premium investments that align with your financial goals.
                </p>
            </div>
            <div class="bg-gray-800/50 rounded-xl p-8 border border-gray-700/50 hover:border-amber-400/50 transition-colors">
                <div class="w-14 h-14 rounded-lg bg-amber-400/10 flex items-center justify-center mb-6">
                    <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Investment Advisory</h3>
                <p class="text-gray-400 leading-relaxed">
                    Data-driven market analysis and personalized investment strategies to maximize returns and build long-term wealth.
                </p>
            </div>
            <div class="bg-gray-800/50 rounded-xl p-8 border border-gray-700/50 hover:border-amber-400/50 transition-colors">
                <div class="w-14 h-14 rounded-lg bg-amber-400/10 flex items-center justify-center mb-6">
                    <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold mb-3">Portfolio Management</h3>
                <p class="text-gray-400 leading-relaxed">
                    Comprehensive property management services ensuring optimal performance and value appreciation across your portfolio.
                </p>
            </div>
        </div>
    </section>

    <!-- Featured Properties Section -->
    <section class="py-16 border-t border-gray-700/50" id="properties">
        <div class="text-center mb-12">
            <span class="text-amber-400 font-medium tracking-wider uppercase text-sm">Exclusive Listings</span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Featured Properties</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="group bg-gray-800/50 rounded-xl overflow-hidden border border-gray-700/50 hover:border-amber-400/50 transition-all">
                <div class="aspect-[4/3] bg-gray-700 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-amber-400/20 to-gray-800/80 flex items-center justify-center">
                        <span class="text-gray-400">Property Image</span>
                    </div>
                    <div class="absolute top-4 left-4">
                        <span class="px-3 py-1 bg-amber-500 text-gray-900 text-xs font-semibold rounded-full">Featured</span>
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-3">
                        <h3 class="text-lg font-semibold">Oceanfront Villa</h3>
                        <span class="text-amber-400 font-bold">$2.8M</span>
                    </div>
                    <p class="text-gray-400 text-sm mb-4">Malibu, California</p>
                    <div class="flex gap-4 text-sm text-gray-500">
                        <span>5 Beds</span>
                        <span>4 Baths</span>
                        <span>4,200 sq ft</span>
                    </div>
                </div>
            </div>
            <div class="group bg-gray-800/50 rounded-xl overflow-hidden border border-gray-700/50 hover:border-amber-400/50 transition-all">
                <div class="aspect-[4/3] bg-gray-700 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-amber-400/20 to-gray-800/80 flex items-center justify-center">
                        <span class="text-gray-400">Property Image</span>
                    </div>
                    <div class="absolute top-4 left-4">
                        <span class="px-3 py-1 bg-green-500 text-gray-900 text-xs font-semibold rounded-full">New</span>
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-3">
                        <h3 class="text-lg font-semibold">Downtown Penthouse</h3>
                        <span class="text-amber-400 font-bold">$3.5M</span>
                    </div>
                    <p class="text-gray-400 text-sm mb-4">Manhattan, New York</p>
                    <div class="flex gap-4 text-sm text-gray-500">
                        <span>3 Beds</span>
                        <span>3 Baths</span>
                        <span>3,500 sq ft</span>
                    </div>
                </div>
            </div>
            <div class="group bg-gray-800/50 rounded-xl overflow-hidden border border-gray-700/50 hover:border-amber-400/50 transition-all">
                <div class="aspect-[4/3] bg-gray-700 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-amber-400/20 to-gray-800/80 flex items-center justify-center">
                        <span class="text-gray-400">Property Image</span>
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-3">
                        <h3 class="text-lg font-semibold">Mountain Retreat</h3>
                        <span class="text-amber-400 font-bold">$1.9M</span>
                    </div>
                    <p class="text-gray-400 text-sm mb-4">Aspen, Colorado</p>
                    <div class="flex gap-4 text-sm text-gray-500">
                        <span>4 Beds</span>
                        <span>3 Baths</span>
                        <span>3,800 sq ft</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-10">
            <a href="#" class="btn btn-outline">View All Properties</a>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="py-16 border-t border-gray-700/50">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
                <span class="text-amber-400 font-medium tracking-wider uppercase text-sm">Why Choose Us</span>
                <h2 class="mt-3 text-3xl sm:text-4xl font-bold mb-6">Experience the Difference</h2>
                <p class="text-gray-400 mb-8 text-lg">
                    At Uber Property Investments, we combine market expertise with personalized service to deliver exceptional results for our clients.
                </p>
                <ul class="space-y-4">
                    <li class="flex items-start gap-4">
                        <div class="w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0 mt-1">
                            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-1">Market Expertise</h4>
                            <p class="text-gray-400 text-sm">Deep understanding of local and global real estate markets with data-driven insights.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <div class="w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0 mt-1">
                            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-1">Exclusive Network</h4>
                            <p class="text-gray-400 text-sm">Access to off-market properties and premium investment opportunities.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <div class="w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0 mt-1">
                            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-1">Personalized Service</h4>
                            <p class="text-gray-400 text-sm">Tailored strategies aligned with your unique investment goals and timeline.</p>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="bg-gray-800/50 rounded-xl p-8 border border-gray-700/50">
                <blockquote class="text-lg text-gray-300 italic mb-6">
                    "Working with Uber Property Investments transformed our approach to real estate investing. Their expertise and dedication helped us build a portfolio that exceeded our expectations."
                </blockquote>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-amber-400/20 flex items-center justify-center">
                        <span class="text-amber-400 font-semibold">JW</span>
                    </div>
                    <div>
                        <div class="font-semibold">James Wilson</div>
                        <div class="text-sm text-gray-400">Investment Client</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 border-t border-gray-700/50" id="contact">
        <div class="max-w-2xl mx-auto text-center">
            <span class="text-amber-400 font-medium tracking-wider uppercase text-sm">Get In Touch</span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold mb-6">Start Your Investment Journey</h2>
            <p class="text-gray-400 mb-8">
                Ready to explore premium real estate opportunities? Contact our team of experts for a personalized consultation.
            </p>
            <form class="space-y-4 text-left">
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label for="name" class="block text-sm font-medium mb-2">Full Name</label>
                        <input type="text" id="name" name="name" placeholder="John Doe" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition-colors" />
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-medium mb-2">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="john@example.com" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition-colors" />
                    </div>
                </div>
                <div>
                    <label for="phone" class="block text-sm font-medium mb-2">Phone Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition-colors" />
                </div>
                <div>
                    <label for="interest" class="block text-sm font-medium mb-2">Investment Interest</label>
                    <select id="interest" name="interest" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition-colors">
                        <option value="">Select your interest</option>
                        <option value="residential">Residential Properties</option>
                        <option value="commercial">Commercial Properties</option>
                        <option value="investment">Investment Portfolio</option>
                        <option value="luxury">Luxury Homes</option>
                    </select>
                </div>
                <div>
                    <label for="message" class="block text-sm font-medium mb-2">Message</label>
                    <textarea id="message" name="message" rows="4" placeholder="Tell us about your investment goals..." class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition-colors resize-none"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-full">Send Message</button>
            </form>
        </div>
    </section>
</Layout>
